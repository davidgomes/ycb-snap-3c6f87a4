# Tests for vector index candidates and recommendations. Vector indexes are
# recommended for KNN queries that ORDER BY a vector distance operator
# (<->, <=>, or <#>) with a LIMIT.

exec-ddl
CREATE TABLE items (
  id INT PRIMARY KEY,
  category INT,
  embedding VECTOR(3)
)
----

# Use a large table so a prefix vector index is cheaper than scanning all rows
# that match an equality predicate and then computing distances.
exec-ddl
ALTER TABLE items INJECT STATISTICS '[
  {
    "columns": ["id"],
    "created_at": "2018-01-01 1:00:00.00000+00:00",
    "row_count": 100000,
    "distinct_count": 100000
