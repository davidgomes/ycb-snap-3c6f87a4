/* setup */
CREATE DOMAIN salary AS INT CHECK (VALUE > 0);
CREATE SCHEMA payroll;
CREATE TABLE employees (id INT PRIMARY KEY, pay salary);
INSERT INTO employees VALUES (1, 100);

/* test */
EXPLAIN (DDL) ALTER DOMAIN salary SET SCHEMA payroll;
