#
# RECORD, associative-array, and SYS_REFCURSOR reject meaningless
# data type attributes in stored-program declarations.
#
SET sql_mode=ORACLE;
# Valid declarations
CREATE PROCEDURE p_ok AS
TYPE rect IS RECORD (a INT);
TYPE aat IS TABLE OF INT INDEX BY INT;
v1 rect;
v2 aat;
c SYS_REFCURSOR;
BEGIN
NULL;
END;
/
# RECORD type alias
CREATE PROCEDURE p_rec_len AS
TYPE rect IS RECORD (a INT);
v rect(10);
BEGIN
NULL;
END;
/
ERROR HY000: Data type 'rect' doesn't support LENGTH attribute.
CREATE PROCEDURE p_rec_dec AS
TYPE rect IS RECORD (a INT);
v rect(10,2);
BEGIN
NULL;
END;
/
ERROR HY000: Data type 'rect' doesn't support LENGTH attribute.
CREATE PROCEDURE p_rec_srid AS
TYPE rect IS RECORD (a INT);
v rect REF_SYSTEM_ID=4326;
BEGIN
NULL;
END;
/
ERROR HY000: Data type 'rect' doesn't support REF_SYSTEM_ID attribute.
CREATE PROCEDURE p_rec_cs AS
TYPE rect IS RECORD (a INT);
v rect CHARACTER SET utf8mb4;
BEGIN
NULL;
END;
/
ERROR HY000: Data type 'rect' doesn't support CHARACTER SET attribute.
CREATE PROCEDURE p_rec_coll AS
TYPE rect IS RECORD (a INT);
v rect COLLATE utf8mb4_bin;
BEGIN
NULL;
END;
/
ERROR HY000: Data type 'rect' doesn't support CHARACTER SET attribute.
# Associative-array type alias
CREATE PROCEDURE p_aa_len AS
TYPE aat IS TABLE OF INT INDEX BY INT;
v aat(10);
BEGIN
NULL;
END;
/
ERROR HY000: Data type 'aat' doesn't support LENGTH attribute.
CREATE PROCEDURE p_aa_dec AS
TYPE aat IS TABLE OF INT INDEX BY INT;
v aat(10,2);
BEGIN
NULL;
END;
/
ERROR HY000: Data type 'aat' doesn't support LENGTH attribute.
CREATE PROCEDURE p_aa_srid AS
TYPE aat IS TABLE OF INT INDEX BY INT;
v aat REF_SYSTEM_ID=4326;
BEGIN
NULL;
END;
/
ERROR HY000: Data type 'aat' doesn't support REF_SYSTEM_ID attribute.
CREATE PROCEDURE p_aa_cs AS
TYPE aat IS TABLE OF INT INDEX BY INT;
v aat CHARACTER SET utf8mb4;
BEGIN
NULL;
END;
/
ERROR HY000: Data type 'aat' doesn't support CHARACTER SET attribute.
CREATE PROCEDURE p_aa_coll AS
TYPE aat IS TABLE OF INT INDEX BY INT;
v aat COLLATE utf8mb4_bin;
BEGIN
NULL;
END;
/
ERROR HY000: Data type 'aat' doesn't support CHARACTER SET attribute.
# Named plugin type in the same declaration syntax
CREATE PROCEDURE p_cur_len AS
c SYS_REFCURSOR(10);
BEGIN
NULL;
END;
/
ERROR HY000: Data type 'SYS_REFCURSOR' doesn't support LENGTH attribute.
CREATE PROCEDURE p_cur_dec AS
c SYS_REFCURSOR(10,2);
BEGIN
NULL;
END;
/
ERROR HY000: Data type 'SYS_REFCURSOR' doesn't support LENGTH attribute.
CREATE PROCEDURE p_cur_srid AS
c SYS_REFCURSOR REF_SYSTEM_ID=4326;
BEGIN
NULL;
END;
/
ERROR HY000: Data type 'SYS_REFCURSOR' doesn't support REF_SYSTEM_ID attribute.
CREATE PROCEDURE p_cur_cs AS
c SYS_REFCURSOR CHARACTER SET utf8mb4;
BEGIN
NULL;
END;
/
ERROR HY000: Data type 'SYS_REFCURSOR' doesn't support CHARACTER SET attribute.
CREATE PROCEDURE p_cur_coll AS
c SYS_REFCURSOR COLLATE utf8mb4_bin;
BEGIN
NULL;
END;
/
ERROR HY000: Data type 'SYS_REFCURSOR' doesn't support CHARACTER SET attribute.
CREATE PROCEDURE p_aa_plugin AS
v associative_array(10);
BEGIN
NULL;
END;
/
ERROR HY000: Data type 'associative_array' doesn't support LENGTH attribute.
DROP PROCEDURE p_ok;
