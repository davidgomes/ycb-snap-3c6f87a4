SET sql_mode=ORACLE;

--echo #
--echo # Data type attributes are not allowed for RECORD, assoc arrays
--echo # and SYS_REFCURSOR variables
--echo #

--echo #
--echo # RECORD
--echo #

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE rec_t IS RECORD (a INT, b VARCHAR(10));
  r rec_t(10);
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE rec_t IS RECORD (a INT, b VARCHAR(10));
  r rec_t(10,2);
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE rec_t IS RECORD (a INT, b VARCHAR(10));
  r rec_t REF_SYSTEM_ID=4326;
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE rec_t IS RECORD (a INT, b VARCHAR(10));
  r rec_t CHARACTER SET utf8mb4;
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE rec_t IS RECORD (a INT, b VARCHAR(10));
  r rec_t COLLATE utf8mb4_bin;
BEGIN
  NULL;
END;
$$
CREATE PACKAGE pkg1 AS
  PROCEDURE p0;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PACKAGE BODY pkg1 AS
  TYPE rec_t IS RECORD (a INT, b VARCHAR(10));
  PROCEDURE p1(p rec_t(10)) AS
  BEGIN
    NULL;
  END;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PACKAGE BODY pkg1 AS
  TYPE rec_t IS RECORD (a INT, b VARCHAR(10));
  FUNCTION f1 RETURN rec_t CHARACTER SET utf8mb4 AS
  BEGIN
    RETURN NULL;
  END;
END;
$$
DROP PACKAGE pkg1;
$$
CREATE PROCEDURE p1 AS
  TYPE rec_t IS RECORD (a INT, b VARCHAR(10) CHARACTER SET utf8mb4);
  r rec_t:= rec_t(1, 'b1');
BEGIN
  SELECT r.a, r.b;
END;
$$
DELIMITER ;$$
CALL p1;
DROP PROCEDURE p1;

--echo #
--echo # Associative array
--echo #

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE assoc_t IS TABLE OF INT INDEX BY INT;
  a assoc_t(10);
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE assoc_t IS TABLE OF INT INDEX BY INT;
  a assoc_t(10,2);
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE assoc_t IS TABLE OF INT INDEX BY INT;
  a assoc_t REF_SYSTEM_ID=4326;
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE assoc_t IS TABLE OF INT INDEX BY INT;
  a assoc_t CHARACTER SET utf8mb4;
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE assoc_t IS TABLE OF INT INDEX BY INT;
  a assoc_t COLLATE utf8mb4_bin;
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE rec_t IS RECORD (a INT, b VARCHAR(10));
  TYPE assoc_t IS TABLE OF rec_t(10) INDEX BY INT;
BEGIN
  NULL;
END;
$$
CREATE PROCEDURE p1 AS
  TYPE assoc_t IS TABLE OF VARCHAR(10) CHARACTER SET utf8mb4
                  INDEX BY VARCHAR(10) COLLATE utf8mb4_bin;
  a assoc_t;
BEGIN
  a('k1'):= 'v1';
  SELECT a('k1'), a.COUNT;
END;
$$
DELIMITER ;$$
CALL p1;
DROP PROCEDURE p1;

--echo #
--echo # SYS_REFCURSOR
--echo #

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  c SYS_REFCURSOR(10);
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  c SYS_REFCURSOR(10,2);
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  c SYS_REFCURSOR REF_SYSTEM_ID=4326;
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  c SYS_REFCURSOR CHARACTER SET utf8mb4;
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  c SYS_REFCURSOR COLLATE utf8mb4_bin;
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1(c OUT SYS_REFCURSOR(10)) AS
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE FUNCTION f1 RETURN SYS_REFCURSOR(10) AS
BEGIN
  RETURN NULL;
END;
$$
CREATE PROCEDURE p1 AS
  c SYS_REFCURSOR;
  v INT;
BEGIN
  OPEN c FOR SELECT 1 FROM DUAL;
  FETCH c INTO v;
  CLOSE c;
  SELECT v;
END;
$$
DELIMITER ;$$
CALL p1;
DROP PROCEDURE p1;

--echo #
--echo # Named types still accept the attributes they support
--echo #

DELIMITER $$;
CREATE PROCEDURE p1 AS
  a INET6;
  b VARCHAR(10) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin;
BEGIN
  a:= '::1';
  b:= 'b1';
  SELECT a, b, COLLATION(b);
END;
$$
DELIMITER ;$$
CALL p1;
DROP PROCEDURE p1;

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  a INET6(10);
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  a INET6 CHARACTER SET utf8mb4;
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

SET sql_mode=DEFAULT;
