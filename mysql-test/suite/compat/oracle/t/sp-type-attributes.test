SET sql_mode=ORACLE;

--echo #
--echo # Data type attributes are not supported by
--echo # RECORD, associative array and SYS_REFCURSOR variables
--echo #

--echo #
--echo # RECORD
--echo #

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE rec_t IS RECORD (a INT);
  r rec_t(10);
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE rec_t IS RECORD (a INT);
  r rec_t(10,2);
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE rec_t IS RECORD (a INT);
  r rec_t REF_SYSTEM_ID=4326;
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE rec_t IS RECORD (a INT);
  r rec_t CHARACTER SET utf8mb4;
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE rec_t IS RECORD (a INT);
  r rec_t COLLATE utf8mb4_bin;
BEGIN
  NULL;
END;
$$
CREATE PROCEDURE p1 AS
  TYPE rec_t IS RECORD (a INT);
  r rec_t:= rec_t(1);
BEGIN
  SELECT r.a;
END;
$$
DELIMITER ;$$
CALL p1;
DROP PROCEDURE p1;

--echo #
--echo # Associative array
--echo #

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE assoc_t IS TABLE OF INT INDEX BY INT;
  a assoc_t(10);
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE assoc_t IS TABLE OF INT INDEX BY INT;
  a assoc_t(10,2);
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE assoc_t IS TABLE OF INT INDEX BY INT;
  a assoc_t REF_SYSTEM_ID=4326;
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE assoc_t IS TABLE OF INT INDEX BY INT;
  a assoc_t CHARACTER SET utf8mb4;
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  TYPE assoc_t IS TABLE OF INT INDEX BY INT;
  a assoc_t COLLATE utf8mb4_bin;
BEGIN
  NULL;
END;
$$
CREATE PROCEDURE p1 AS
  TYPE assoc_t IS TABLE OF INT INDEX BY INT;
  a assoc_t;
BEGIN
  a(1):= 10;
  SELECT a(1);
END;
$$
DELIMITER ;$$
CALL p1;
DROP PROCEDURE p1;

--echo #
--echo # SYS_REFCURSOR
--echo #

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  c SYS_REFCURSOR(10);
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  c SYS_REFCURSOR(10,2);
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  c SYS_REFCURSOR REF_SYSTEM_ID=4326;
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  c SYS_REFCURSOR CHARACTER SET utf8mb4;
BEGIN
  NULL;
END;
$$
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p1 AS
  c SYS_REFCURSOR COLLATE utf8mb4_bin;
BEGIN
  NULL;
END;
$$
CREATE PROCEDURE p1 AS
  c SYS_REFCURSOR;
  v INT;
BEGIN
  OPEN c FOR SELECT 1;
  FETCH c INTO v;
  CLOSE c;
  SELECT v;
END;
$$
DELIMITER ;$$
CALL p1;
DROP PROCEDURE p1;
