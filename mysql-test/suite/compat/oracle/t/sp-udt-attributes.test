--echo #
--echo # RECORD, associative-array, and SYS_REFCURSOR variables reject
--echo # length, decimals, REF_SYSTEM_ID, CHARACTER SET, and COLLATE.
--echo #

SET sql_mode=ORACLE;

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p_rec_len()
AS
  TYPE rt IS RECORD(a INT);
  v rt(10);
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p_rec_dec()
AS
  TYPE rt IS RECORD(a INT);
  v rt(10,2);
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p_rec_srid()
AS
  TYPE rt IS RECORD(a INT);
  v rt REF_SYSTEM_ID=4326;
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p_rec_cs()
AS
  TYPE rt IS RECORD(a INT);
  v rt CHARACTER SET latin1;
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p_rec_coll()
AS
  TYPE rt IS RECORD(a INT);
  v rt COLLATE latin1_bin;
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p_aa_len()
AS
  TYPE aa IS TABLE OF INT INDEX BY INT;
  v aa(10);
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p_aa_dec()
AS
  TYPE aa IS TABLE OF INT INDEX BY INT;
  v aa(10,2);
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p_aa_srid()
AS
  TYPE aa IS TABLE OF INT INDEX BY INT;
  v aa REF_SYSTEM_ID=4326;
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p_aa_cs()
AS
  TYPE aa IS TABLE OF INT INDEX BY INT;
  v aa CHARACTER SET latin1;
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p_aa_coll()
AS
  TYPE aa IS TABLE OF INT INDEX BY INT;
  v aa COLLATE latin1_bin;
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p_rc_len()
AS
  v SYS_REFCURSOR(10);
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p_rc_dec()
AS
  v SYS_REFCURSOR(10,2);
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p_rc_srid()
AS
  v SYS_REFCURSOR REF_SYSTEM_ID=4326;
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p_rc_cs()
AS
  v SYS_REFCURSOR CHARACTER SET latin1;
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p_rc_coll()
AS
  v SYS_REFCURSOR COLLATE latin1_bin;
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

--echo #
--echo # Plugin type name uses the same declaration syntax.
--echo #
DELIMITER $$;
--error ER_UNSUPPORTED_DATA_TYPE_ATTRIBUTE
CREATE PROCEDURE p_plugin_aa()
AS
  v associative_array(10);
BEGIN
  NULL;
END;
$$
DELIMITER ;$$

DELIMITER $$;
CREATE PROCEDURE p_ok()
AS
  TYPE rt IS RECORD(a INT);
  TYPE aa IS TABLE OF INT INDEX BY INT;
  r rt;
  m aa;
  c SYS_REFCURSOR;
BEGIN
  NULL;
END;
$$
DELIMITER ;$$
DROP PROCEDURE p_ok;
